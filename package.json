{
  "name": "tejun",
  "version": "0.0.0",
  "private": true,
  "description": "Tejun (手順): a safety-checked language for programming one factory machine station, compiling to IEC 61131-3 Structured Text.",
  "type": "module",
  "workspaces": [
    "packages/compiler",
    "packages/runtime",
    "packages/cli",
    "packages/playground"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tests --noEmit && tsc -p packages/playground --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "playground": "npm run dev -w @tejun/playground",
    "build:playground": "npm run build -w @tejun/playground"
  },
  "devDependencies": {
    "@tejun/cli": "0.0.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
